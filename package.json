{
  "name": "smacdo-www",
  "private": true,
  "scripts": {
    "build:demos": "npx esbuild src/demos/blockbreaker/demo.ts --bundle --outfile=public/js/demos/blockbreaker.js",
    "build:site": "npx esbuild src/site/header.ts --bundle --outfile=public/js/site.js",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,css,md}\"",
    "format": "prettier --write \"**/*.{ts,js,mjs,css,md}\"",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
