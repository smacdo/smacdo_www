{
  "name": "smacdo-www",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:js && npm run build:zola",
    "build:js": "npm run build:site && npm run build:demos && npm run build:brainfreeze",
    "build:zola": "zola build",
    "build:site": "npx esbuild src/site/header.ts --bundle --outfile=static/js/site.js",
    "build:demos": "npx esbuild src/demos/blockbreaker/demo.ts --bundle --outfile=static/js/demos/blockbreaker.js",
    "build:brainfreeze": "npx esbuild src/demos/brainfreeze/demo.js --bundle --outfile=static/js/demos/brainfreeze.js",
    "serve": "zola serve",
    "clean": "node -e \"for (const p of ['public','static/js/demos','static/js/site.js']) require('fs').rmSync(p,{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,mjs,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,css,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
