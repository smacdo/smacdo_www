{
  "name": "smacdo-www",
  "private": true,
  "scripts": {
    "build": "npm run build:zola && npm run build:site && npm run build:demos && npm run build:brainfreeze",
    "build:zola": "zola build",
    "build:site": "npx esbuild src/site/header.ts --bundle --outfile=public/js/site.js",
    "build:demos": "npx esbuild src/demos/blockbreaker/demo.ts --bundle --outfile=public/js/demos/blockbreaker.js",
    "build:brainfreeze": "npx esbuild src/demos/brainfreeze/demo.js --bundle --outfile=public/js/demos/brainfreeze.js",
    "serve": "zola serve",
    "clean": "node -e \"require('fs').rmSync('public',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,mjs,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,css,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
