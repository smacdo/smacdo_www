{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "lib": [
      "ES2022", "DOM", "DOM.Iterable"
    ],
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "types": [
      "vitest/globals"
    ]
  },
  "include": ["src/**/*.ts", "src/**/*.js"]
}